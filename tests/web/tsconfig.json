{
	/* Browser tests, the web modules with their tests, and the runner configs: the test config plus the DOM, which the API tester never sees. */
	"extends": "../../tsconfig.test.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		/* The consumer project imports the package by name, as a consumer does; this check reads the source. */
		"paths": {
			"@workerstack/testing/web": ["../../src/web/index.ts"],
			"@workerstack/testing/web/dom": ["../../src/web/dom/index.ts"]
		}
	},
	"include": ["./**/*.ts", "../../src/web/**/*.ts", "../../playwright.config.ts", "../../vitest.web.config.ts"],
	"exclude": []
}
