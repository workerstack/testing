{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"extends": ["./oxlint.base.json"],
	"plugins": ["typescript", "unicorn", "oxc", "vitest"],
	"jsPlugins": [
		{
			"name": "testing",
			"specifier": "./lint/index.ts"
		}
	],
	"env": {
		"node": true
	},
	"ignorePatterns": [
		"dist/**",
		"coverage/**",
		"testing-out/**",
		".testing/api/**",
		"labs/api/node_modules/**",
		"labs/api/schema/**",
		".agents/**",
		".claude/**",
		".codex/**",
		".gemini/**",
		".grok/**",
		".rulesync/**"
	],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"rules": {
		"no-unused-vars": "warn",
		"testing/exit-only-in-cli": "error",
		"testing/grammar-through-renderer": "error",
		"testing/id-through-reader": "error",
		"testing/network-through-client": "error",
		"testing/proven-id-origin": "error",
		"unicorn/no-array-sort": "off",
		"unicorn/prefer-string-starts-ends-with": "warn",
		"complexity": ["error", 15],
		"max-depth": ["error", 4],
		"max-lines": ["error", 300],
		"max-lines-per-function": ["error", 60],
		"unicorn/consistent-function-scoping": "error",
		"vitest/expect-expect": "error",
		"vitest/no-conditional-expect": "error",
		"vitest/no-disabled-tests": "error",
		"vitest/no-focused-tests": "error",
		"testing/boundaries": "error",
		"testing/index-purity": "error",
		"testing/no-console": "error",
		"testing/no-header-branching": "error",
		"testing/no-module-side-effects": "error",
		"testing/no-module-state": "error",
		"testing/no-v8-ignore": "error",
		"testing/max-params": "error"
	},
	"overrides": [
		{
			"files": ["labs/api/**/*.{ts,mjs,js}"],
			"rules": {
				"typescript/no-explicit-any": "off"
			}
		},
		{
			"files": ["**/*.test.ts", "tests/**", "**/__fixtures__/**"],
			"rules": {
				"max-lines": ["error", 500]
			}
		}
	]
}
