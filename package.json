{
	"name": "@workerstack/testing",
	"version": "0.32.2",
	"description": "Testing for APIs, web apps and Workers: /api tests a live HTTP API against its OpenAPI document",
	"keywords": [
		"api",
		"contract-testing",
		"openapi",
		"swagger",
		"testing",
		"workerstack"
	],
	"homepage": "https://github.com/workerstack/testing#readme",
	"bugs": {
		"url": "https://github.com/workerstack/testing/issues"
	},
	"license": "MIT",
	"author": "lovrozagar",
	"repository": {
		"type": "git",
		"url": "https://github.com/workerstack/testing.git"
	},
	"bin": {
		"testing": "./bin/testing.js"
	},
	"files": [
		"bin/testing.js",
		"dist",
		"!dist/**/*.map",
		"README.md",
		"docs",
		"LICENSE",
		"labs/api/annotated-openapi.yaml",
		"labs/api/local.config.ts",
		"labs/api/minimal.config.ts",
		"labs/api/oob-auth.config.ts",
		"labs/api/demo.mjs",
		"labs/api/README.md"
	],
	"type": "module",
	"exports": {
		"./api": {
			"types": "./dist/api/index.d.ts",
			"default": "./dist/api/index.js"
		},
		"./api/steps": {
			"types": "./dist/api/steps/index.d.ts",
			"default": "./dist/api/steps/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"bisect": "node labs/api/bisect.mjs",
		"build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
		"check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
		"conformance": "node dist/api/cli.js conformance",
		"conformance:sharded": "bun scripts/conformance-sharded.ts",
		"demo": "bun run build && node labs/api/demo.mjs",
		"dev": "tsc -p tsconfig.json --watch",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"grunt:antigravity": "antigravity --dangerously-skip-permissions",
		"grunt:claude": "claude --dangerously-skip-permissions",
		"grunt:clean": "node ./.rulesync/scripts/clean.mjs",
		"grunt:codex": "codex --dangerously-bypass-approvals-and-sandbox",
		"grunt:doctor": "node ./.rulesync/scripts/doctor.mjs",
		"grunt:gemini": "gemini --yolo",
		"grunt:grok": "grok --yolo",
		"grunt:hooks:check": "node .rulesync/scripts/hooks-union.mjs --check",
		"grunt:hooks:union": "node .rulesync/scripts/hooks-union.mjs",
		"grunt:purge:global-mcps": "node .rulesync/scripts/purge-global-mcps.mjs",
		"grunt:purge:global-mcps:apply": "node .rulesync/scripts/purge-global-mcps.mjs --apply",
		"grunt:rulesync:check": "node ./.rulesync/scripts/guarded-roots.mjs check",
		"grunt:rulesync:doctor": "rulesync doctor",
		"grunt:rulesync:generate": "node ./.rulesync/scripts/guarded-roots.mjs generate",
		"grunt:rulesync:watch": "node ./.rulesync/scripts/guarded-roots.mjs watch",
		"grunt:setup": "node ./.rulesync/scripts/setup.mjs",
		"grunt:sync:globals": "node .rulesync/scripts/sync-global-settings.mjs",
		"grunt:sync:globals:apply": "node .rulesync/scripts/sync-global-settings.mjs --apply",
		"grunt:sync:globals:check": "node .rulesync/scripts/check-globals.mjs",
		"labs": "node labs/api/serve.ts",
		"labs:sweep": "bash labs/api/sweep.sh",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix",
		"prepare": "lefthook install --reset-hooks-path",
		"prepublishOnly": "bun run build",
		"test": "bun run build && bun run test:unit && bun run test:integration && node dist/api/cli.js conformance",
		"test:e2e": "bun run build && vitest run -c vitest.e2e.config.ts",
		"test:integration": "vitest run --project integration",
		"test:targets": "vitest run -c vitest.targets.config.ts",
		"test:unit": "vitest run --project unit --coverage",
		"typecheck": "bun run check"
	},
	"dependencies": {
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@clack/prompts": "^0.11.0",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@lovrozagar/grunt": "0.16.1",
		"@types/node": "^22.10.0",
		"@vitest/coverage-v8": "4.1.10",
		"fast-check": "4.10.2",
		"lefthook": "2.2.2",
		"oxc-parser": "0.152.0",
		"oxfmt": "0.77.0",
		"oxlint": "1.92.0",
		"postgres": "^3.4.9",
		"rulesync": "16.17.0",
		"smol-toml": "^1.8.0",
		"typescript": "^5.7.2",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"postgres": "^3.4"
	},
	"peerDependenciesMeta": {
		"postgres": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"packageManager": "bun@1.4.4",
	"standards": {
		"repo": "testing",
		"gates": [
			"test:integration",
			"test:e2e"
		],
		"ci": [
			"fmt:check",
			"lint",
			"typecheck",
			"test",
			"test:integration",
			"test:e2e"
		]
	}
}
