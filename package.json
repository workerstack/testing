{
	"name": "@workerstack/testing",
	"version": "0.35.0",
	"description": "Testing for APIs, web apps and Workers: /api tests a live HTTP API against its OpenAPI document; /web guards, readies, scans and network-gates Playwright tests",
	"keywords": [
		"api",
		"contract-testing",
		"openapi",
		"swagger",
		"testing",
		"workerstack"
	],
	"homepage": "https://github.com/workerstack/testing#readme",
	"bugs": {
		"url": "https://github.com/workerstack/testing/issues"
	},
	"license": "MIT",
	"author": "lovrozagar",
	"repository": {
		"type": "git",
		"url": "https://github.com/workerstack/testing.git"
	},
	"bin": {
		"testing": "./bin/testing.js"
	},
	"files": [
		"bin/testing.js",
		"dist",
		"README.md",
		"docs",
		"LICENSE",
		"labs/api/annotated-openapi.yaml",
		"labs/api/local.config.ts",
		"labs/api/minimal.config.ts",
		"labs/api/oob-auth.config.ts",
		"labs/api/demo.mjs",
		"labs/api/README.md"
	],
	"type": "module",
	"exports": {
		"./api": {
			"types": "./dist/api/index.d.ts",
			"default": "./dist/api/index.js"
		},
		"./api/steps": {
			"types": "./dist/api/steps/index.d.ts",
			"default": "./dist/api/steps/index.js"
		},
		"./web": {
			"types": "./dist/web/index.d.ts",
			"default": "./dist/web/index.js"
		},
		"./web/dom": {
			"types": "./dist/web/dom/index.d.ts",
			"default": "./dist/web/dom/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"bisect": "node labs/api/bisect.mjs",
		"build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && tsc -p tsconfig.web.json",
		"check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json && tsc -p tests/web/tsconfig.json",
		"conformance": "node dist/api/cli.js conformance",
		"conformance:sharded": "bun scripts/conformance-sharded.ts",
		"demo": "bun run build && node labs/api/demo.mjs",
		"dev": "tsc -p tsconfig.json --watch",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"labs": "node labs/api/serve.ts",
		"labs:sweep": "bash labs/api/sweep.sh",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix",
		"postinstall": "repo sync --postinstall",
		"prepare": "lefthook install --reset-hooks-path",
		"prepublishOnly": "bun run build",
		"test": "bun run build && bun run test:unit && bun run test:integration && node dist/api/cli.js conformance",
		"test:e2e": "bun run build && vitest run -c vitest.e2e.config.ts",
		"test:integration": "vitest run --project integration",
		"test:targets": "vitest run -c vitest.targets.config.ts",
		"test:unit": "vitest run --project unit --coverage",
		"test:web": "bun run build && playwright test && vitest run -c vitest.web.config.ts",
		"typecheck": "bun run check"
	},
	"dependencies": {
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@clack/prompts": "^0.11.0",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@hono/node-server": "^1.19.0",
		"@playwright/test": "1.64.1",
		"@types/node": "^22.10.0",
		"@vitest/browser-playwright": "5.0.5",
		"@vitest/coverage-v8": "5.0.5",
		"@workerstack/repo": "0.2.0-rc.2",
		"fast-check": "4.10.2",
		"hono": "^4.9.0",
		"lefthook": "2.2.2",
		"oxc-parser": "0.152.0",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"playwright": "1.64.1",
		"postgres": "^3.4.9",
		"smol-toml": "^1.8.0",
		"typescript": "7.0.2",
		"typescript-5.9": "npm:typescript@5.9.3",
		"vitest": "5.0.5"
	},
	"peerDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.64.1",
		"postgres": "^3.4",
		"vitest": "^5.0.5"
	},
	"peerDependenciesMeta": {
		"@axe-core/playwright": {
			"optional": true
		},
		"@playwright/test": {
			"optional": true
		},
		"postgres": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"packageManager": "bun@1.4.4"
}
