{
  "name": "@workerstack/testing",
  "version": "0.35.0",
  "private": false,
  "description": "Testing for APIs, web apps and Workers: /api tests a live HTTP API against its OpenAPI document; /web guards, readies, scans and network-gates Playwright tests",
  "keywords": [
    "api",
    "contract-testing",
    "openapi",
    "swagger",
    "testing",
    "workerstack"
  ],
  "homepage": "https://github.com/workerstack/testing#readme",
  "bugs": {
    "url": "https://github.com/workerstack/testing/issues"
  },
  "license": "MIT",
  "author": "lovrozagar",
  "repository": {
    "type": "git",
    "url": "https://github.com/workerstack/testing.git"
  },
  "bin": {
    "testing": "./bin/testing.js"
  },
  "files": [
    "bin/testing.js",
    "dist",
    "README.md",
    "docs",
    "LICENSE",
    "labs/api/annotated-openapi.yaml",
    "labs/api/local.config.ts",
    "labs/api/minimal.config.ts",
    "labs/api/oob-auth.config.ts",
    "labs/api/demo.mjs",
    "labs/api/README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./api/steps": {
      "types": "./dist/api/steps/index.d.ts",
      "default": "./dist/api/steps/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./web/dom": {
      "types": "./dist/web/dom/index.d.ts",
      "default": "./dist/web/dom/index.js"
    },
    "./web/solid": {
      "types": "./dist/web/solid/index.d.ts",
      "solid": "./dist/web/solid/index.js",
      "default": "./dist/web/solid/index.js"
    },
    "./web/solid/vitest": {
      "types": "./dist/web/solid/vitest.d.ts",
      "default": "./dist/web/solid/vitest.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bisect": "node labs/api/bisect.mjs",
    "build": "bun scripts/steps.ts build",
    "build:api": "tsc -p tsconfig.build.json",
    "build:web": "tsc -p tsconfig.web.json",
    "check": "bun scripts/steps.ts typecheck",
    "conformance": "node dist/api/cli.js conformance",
    "conformance:sharded": "bun scripts/conformance-sharded.ts",
    "demo": "bun scripts/steps.ts demo",
    "dev": "tsc -p tsconfig.build.json --watch",
    "fmt": "repo fmt",
    "fmt:check": "repo fmt --check",
    "labs": "node labs/api/serve.ts",
    "labs:demo": "node labs/api/demo.mjs",
    "labs:deploy": "node labs/api/deploy.mjs",
    "labs:provision": "node labs/api/provision.mjs",
    "labs:schema": "node labs/api/dump-schema.mjs",
    "labs:sweep": "bash labs/api/sweep.sh",
    "labs:wipe": "node labs/api/wipe.mjs",
    "lint": "repo lint",
    "lint:fix": "repo lint --fix",
    "postinstall": "repo sync --postinstall",
    "prepack": "bun run build",
    "test": "bun scripts/steps.ts test",
    "test:e2e": "bun scripts/steps.ts test:e2e",
    "test:integration": "vitest run --project integration",
    "test:targets": "vitest run -c vitest.targets.config.ts",
    "test:unit": "vitest run --project unit --coverage",
    "test:web": "bun scripts/steps.ts test:web",
    "typecheck": "bun run check"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "parse5": "^8.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@hono/node-server": "^1.19.0",
    "@playwright/test": "1.64.1",
    "@solidjs/vite-plugin": "3.0.0-next.55",
    "@solidjs/web": "2.0.0-rc.20",
    "@types/node": "^22.10.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@workerstack/repo": "0.2.0",
    "fast-check": "4.10.2",
    "hono": "^4.9.0",
    "oxc-parser": "0.152.0",
    "playwright": "1.64.1",
    "postgres": "^3.4.9",
    "solid-js": "2.0.0-rc.20",
    "typescript": "7.0.2",
    "typescript-5.9": "npm:typescript@5.9.3",
    "vite": "^8.2.1",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@solidjs/vite-plugin": ">=3.0.0-next.55 <4",
    "@solidjs/web": ">=2.0.0-rc.20 <3",
    "postgres": "^3.4",
    "solid-js": ">=2.0.0-rc.20 <3",
    "vite": ">=8 <9",
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "@axe-core/playwright": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "@solidjs/vite-plugin": {
      "optional": true
    },
    "@solidjs/web": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.4"
}
